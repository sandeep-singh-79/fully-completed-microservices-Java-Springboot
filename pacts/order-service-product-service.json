{
  "consumer": {
    "name": "order-service"
  },
  "interactions": [
    {
      "description": "a request with an invalid product ID",
      "key": "754b32e5",
      "pending": false,
      "providerStates": [
        {
          "name": "product ID is invalid"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/product/abc"
      },
      "response": {
        "body": {
          "content": {
            "error": "Invalid product ID"
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "status": 400
      },
      "transport": "http",
      "type": "Synchronous/HTTP"
    },
    {
      "description": "a request for product by ID",
      "key": "ce8512ce",
      "pending": false,
      "providerStates": [
        {
          "name": "product with ID 101 exists"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/product/101"
      },
      "response": {
        "body": {
          "content": {
            "id": 101,
            "name": "iPhone 14",
            "price": 899.99
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.price": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "decimal"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "transport": "http",
      "type": "Synchronous/HTTP"
    },
    {
      "description": "a request for a product with zero price",
      "key": "542b2230",
      "pending": false,
      "providerStates": [
        {
          "name": "product with ID 202 exists and has zero price"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/product/202"
      },
      "response": {
        "body": {
          "content": {
            "id": 202,
            "name": "Free Sample",
            "price": 0.0
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.price": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "decimal"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "transport": "http",
      "type": "Synchronous/HTTP"
    },
    {
      "description": "a request for a non-existent product by ID",
      "key": "4b91dc79",
      "pending": false,
      "providerStates": [
        {
          "name": "product with ID 999 does not exist"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/product/999"
      },
      "response": {
        "body": {
          "content": {
            "error": "Product not found"
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "status": 404
      },
      "transport": "http",
      "type": "Synchronous/HTTP"
    }
  ],
  "metadata": {
    "pact-jvm": {
      "version": "4.6.15"
    },
    "pactSpecification": {
      "version": "4.0"
    }
  },
  "provider": {
    "name": "product-service"
  }
}
